# Google Gemini API key (https://aistudio.google.com/apikey).
# Leave empty to run with the offline mock model (demo mode).
GEMINI_API_KEY=

# "gemini" or "mock". Defaults to "gemini" when GEMINI_API_KEY is set, otherwise "mock".
LLM_PROVIDER=

# Gemini model used for analysis, comma-separated fallbacks tried in order when it is
# overloaded or too slow, and the total time budget for one analysis.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=45

PORT=8000
DB_PATH=./data/healthai.db

# Result cache: max entries and time-to-live.
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=3600

# Max symptom checks per minute per IP address.
RATE_LIMIT_PER_MINUTE=20

# Simulated latency of the mock model, so the cache speed-up is visible offline.
MOCK_LATENCY_SECONDS=1.5
