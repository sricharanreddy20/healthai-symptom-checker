# Anthropic API key. Leave empty to run with the offline mock model (LLM_PROVIDER=mock).
ANTHROPIC_API_KEY=

# "anthropic" or "mock". Defaults to "anthropic" when ANTHROPIC_API_KEY is set, otherwise "mock".
LLM_PROVIDER=

# Model + reasoning effort used for analysis.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
LLM_TIMEOUT_MS=60000

PORT=3000
DB_PATH=./data/healthai.db

# Result cache: max entries and time-to-live.
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=3600

# Simulated latency of the mock model, so the cache speed-up is visible offline.
MOCK_LATENCY_MS=1500
