{
  "name": "healthai",
  "version": "1.0.0",
  "description": "AI-powered symptom checker (HealthAI take-home)",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
